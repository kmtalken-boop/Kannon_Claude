# Kalshi API credentials
# Get these from https://kalshi.com/settings/api-access (demo) or https://demo.kalshi.co
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=./private_key.pem

# Optional: override config.yaml environment
# KALSHI_ENVIRONMENT=demo

# Polymarket US API credentials
# Generate at polymarket.us/developer (requires KYC via the iOS app first).
# key_id  = UUID shown after key creation
# secret_key = Base64-encoded Ed25519 private key — shown ONCE, save immediately
POLYMARKET_KEY_ID=your-uuid-key-id-here
POLYMARKET_SECRET_KEY=your-base64-secret-key-here
